{% extends 'base.html.twig' %}

{% block title %}Contact{% endblock %}
{% block meta_description %}Contactez {{ site.name }} : une question, un projet ? Écrivez-nous, nous vous répondons rapidement.{% endblock %}

{% block structured_data %}
    <script type="application/ld+json">{{ {
        '@context': 'https://schema.org',
        '@type': 'ContactPage',
        name: 'Contact',
        url: url('app_contact'),
    }|json_encode(constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_UNESCAPED_UNICODE') b-or constant('JSON_HEX_TAG'))|raw }}</script>
{% endblock %}

{% block body %}
    <twig:PageHeader title="Contact" intro="Une question, un projet ? Écrivez-nous, nous vous répondons dans les meilleurs délais." :breadcrumb="[{label: 'Contact'}]" />

    <div class="container-page grid gap-12 py-12 lg:grid-cols-3">
        <div class="lg:col-span-2">
            <p class="mb-6 text-sm text-muted">Les champs marqués d'un <span class="text-red-700" aria-hidden="true">*</span><span class="sr-only">astérisque</span> sont obligatoires.</p>

            {{ form_start(form, {attr: {novalidate: 'novalidate', class: 'space-y-6'}}) }}
                {{ form_errors(form) }}
                <div class="grid gap-6 sm:grid-cols-2">
                    {{ form_row(form.name) }}
                    {{ form_row(form.email) }}
                </div>
                <div class="grid gap-6 sm:grid-cols-2">
                    {{ form_row(form.phone) }}
                    {{ form_row(form.subject) }}
                </div>
                {{ form_row(form.message) }}
                {{ form_row(form.consent) }}
                {{ form_row(form.antispam) }}
                {{ form_rest(form) }}

                <twig:Button icon="lucide:send">Envoyer le message</twig:Button>
            {{ form_end(form) }}

            <p class="mt-6 text-xs text-muted">
                Les informations recueillies sont utilisées uniquement pour répondre à votre demande et conservées
                de façon chiffrée. Pour en savoir plus et exercer vos droits, consultez notre
                <a href="{{ path('app_legal_privacy') }}" class="link">politique de confidentialité</a>.
            </p>
        </div>

        <aside aria-labelledby="contact-infos-title" class="space-y-6">
            <h2 id="contact-infos-title" class="text-lg font-semibold text-ink">Nos coordonnées</h2>
            <dl class="space-y-4 text-sm">
                <div class="flex gap-3">
                    <dt><twig:ux:icon name="lucide:mail" class="size-5 text-brand-700" aria-label="Email" /></dt>
                    <dd><a href="mailto:{{ site.email }}" class="link">{{ site.email }}</a></dd>
                </div>
                {% if site.phone %}
                    <div class="flex gap-3">
                        <dt><twig:ux:icon name="lucide:phone" class="size-5 text-brand-700" aria-label="Téléphone" /></dt>
                        <dd><a href="tel:{{ site.phone|replace({' ': ''}) }}" class="link">{{ site.phone }}</a></dd>
                    </div>
                {% endif %}
                <div class="flex gap-3">
                    <dt><twig:ux:icon name="lucide:map-pin" class="size-5 text-brand-700" aria-label="Adresse" /></dt>
                    <dd class="text-muted">{{ site.address.street }}<br>{{ site.address.postal_code }} {{ site.address.city }}</dd>
                </div>
            </dl>
        </aside>
    </div>
{% endblock %}
