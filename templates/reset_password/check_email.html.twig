{% extends 'layout/auth.html.twig' %}

{% block title %}{{ 'reset_password.check_email.title'|trans }}{% endblock %}
{% block heading %}{{ 'reset_password.check_email.title'|trans }}{% endblock %}

{% block card %}
    <div class="space-y-4 text-sm text-muted">
        <div class="flex justify-center"><twig:ux:icon name="lucide:mail-check" class="size-12 text-brand-700" /></div>
        <p>{{ 'reset_password.check_email.text'|trans }}</p>
        <p>{{ 'reset_password.check_email.expires'|trans({'%delay%': resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle')}) }}</p>
        <p>{{ 'reset_password.check_email.spam'|trans }}</p>
    </div>
{% endblock %}

{% block after_card %}
    <p class="mt-6 text-center text-sm text-muted">
        <a href="{{ path('app_forgot_password_request') }}" class="link">{{ 'reset_password.check_email.retry'|trans }}</a>
    </p>
{% endblock %}
