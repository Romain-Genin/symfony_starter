{% extends 'layout/auth.html.twig' %}

{% block title %}Nouveau mot de passe{% endblock %}
{% block heading %}Choisissez un nouveau mot de passe{% endblock %}

{% block card %}
    {{ form_start(form, {attr: {novalidate: 'novalidate', class: 'space-y-5'}}) }}
        {{ form_row(form.plainPassword) }}
        <twig:Button class="w-full" icon="lucide:key-round" iconPosition="start">Enregistrer</twig:Button>
    {{ form_end(form) }}
{% endblock %}
