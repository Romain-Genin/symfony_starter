<a href="{{ path(route, params) }}"
   {% if this.active %}aria-current="page"{% endif %}
   {{ attributes.defaults({class: 'rounded-md px-3 py-2 text-sm font-medium transition-colors ' ~ (this.active ? 'text-brand-700 bg-brand-50' : 'text-ink hover:text-brand-700 hover:bg-brand-50')}) }}>
    {%- block content %}{% endblock -%}
</a>
