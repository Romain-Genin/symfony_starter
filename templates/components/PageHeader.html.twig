{#
    En-tête de page : fil d'Ariane + h1 unique + chapô.
    <twig:PageHeader title="Contact" intro="…" :breadcrumb="[{label: 'Contact'}]" />
#}
{% props title, intro = null, breadcrumb = [] %}
<header {{ attributes.defaults({class: 'border-b border-gray-200 bg-gradient-to-b from-brand-50/60 to-white'}) }}>
    <div class="container-page py-10 sm:py-14">
        {% if breadcrumb %}
            <twig:Breadcrumb :items="breadcrumb" class="mb-4" />
        {% endif %}
        <h1 class="text-3xl font-bold tracking-tight text-ink sm:text-4xl">{{ title }}</h1>
        {% if intro %}
            <p class="mt-3 max-w-2xl text-lg text-muted">{{ intro }}</p>
        {% endif %}
        {% block content %}{% endblock %}
    </div>
</header>
