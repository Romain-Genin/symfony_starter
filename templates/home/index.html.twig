{% extends 'base.html.twig' %}

{% block title %}{% endblock %}
{% block meta_description %}{{ site.description }}{% endblock %}

{% block body %}
    {# Hero #}
    <section class="relative isolate overflow-hidden" aria-labelledby="hero-title">
        <div class="absolute inset-0 -z-10 bg-gradient-to-br from-brand-50 via-white to-accent-300/20" aria-hidden="true"></div>
        <div class="container-page py-20 sm:py-28 lg:py-32">
            <div class="mx-auto max-w-3xl text-center">
                <p class="inline-flex items-center gap-2 rounded-full bg-white/80 px-3 py-1 text-sm font-medium text-brand-800 ring-1 ring-brand-200">
                    <twig:ux:icon name="lucide:sparkles" class="size-4" />
                    Symfony 8 · Tailwind v4 · Alpine · Turbo
                </p>
                <h1 id="hero-title" class="mt-6 text-4xl font-black tracking-tight text-ink sm:text-6xl">
                    {{ 'home.hero.title'|trans }}
                    <span class="bg-gradient-to-r from-brand-700 to-accent-500 bg-clip-text text-transparent">{{ 'home.hero.title_highlight'|trans }}</span>
                </h1>
                <p class="mt-6 text-lg leading-8 text-muted">
                    {{ 'home.hero.text'|trans }}
                </p>
                <div class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row">
                    <twig:Button href="{{ path('app_contact') }}" size="lg" icon="lucide:arrow-right">{{ 'home.hero.cta'|trans }}</twig:Button>
                    <twig:Button href="#fonctionnalites" variant="secondary" size="lg">{{ 'home.hero.discover'|trans }}</twig:Button>
                </div>
            </div>
        </div>
    </section>

    {# Fonctionnalités #}
    <twig:Section id="fonctionnalites" :title="'home.features.title'|trans" :intro="'home.features.intro'|trans" class="bg-gray-50">
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            <twig:Card :title="'home.features.fast.title'|trans" icon="lucide:zap">
                {{ 'home.features.fast.text'|trans }}
            </twig:Card>
            <twig:Card :title="'home.features.design.title'|trans" icon="lucide:palette">
                {{ 'home.features.design.text'|trans }}
            </twig:Card>
            <twig:Card :title="'home.features.a11y.title'|trans" icon="lucide:accessibility">
                {{ 'home.features.a11y.text'|trans }}
            </twig:Card>
            <twig:Card :title="'home.features.encryption.title'|trans" icon="lucide:database">
                {{ 'home.features.encryption.text'|trans }}
            </twig:Card>
            <twig:Card :title="'home.features.emails.title'|trans" icon="lucide:mail-check">
                {{ 'home.features.emails.text'|trans }}
            </twig:Card>
            <twig:Card :title="'home.features.admin.title'|trans" icon="lucide:layout-template">
                {{ 'home.features.admin.text'|trans }}
            </twig:Card>
        </div>
    </twig:Section>

    {# Appel à l'action #}
    <section class="py-16 sm:py-20" aria-labelledby="cta-title">
        <div class="container-page">
            <div class="rounded-3xl bg-brand-900 px-6 py-14 text-center shadow-xl sm:px-12">
                <h2 id="cta-title" class="text-2xl font-bold tracking-tight text-white sm:text-3xl">{{ 'home.cta.title'|trans }}</h2>
                <p class="mx-auto mt-3 max-w-xl text-brand-100">{{ 'home.cta.text'|trans }}</p>
                <div class="mt-8">
                    <twig:Button href="{{ path('app_contact') }}" variant="secondary" size="lg" icon="lucide:send">{{ 'home.cta.button'|trans }}</twig:Button>
                </div>
            </div>
        </div>
    </section>
{% endblock %}
