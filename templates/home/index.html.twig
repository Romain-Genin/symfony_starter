{% extends 'base.html.twig' %}

{% block title %}{% endblock %}
{% block meta_description %}{{ site.description }}{% endblock %}

{% block body %}
    {# Hero #}
    <section class="relative isolate overflow-hidden" aria-labelledby="hero-title">
        <div class="absolute inset-0 -z-10 bg-gradient-to-br from-brand-50 via-white to-accent-300/20" aria-hidden="true"></div>
        <div class="container-page py-20 sm:py-28 lg:py-32">
            <div class="mx-auto max-w-3xl text-center">
                <p class="inline-flex items-center gap-2 rounded-full bg-white/80 px-3 py-1 text-sm font-medium text-brand-800 ring-1 ring-brand-200">
                    <twig:ux:icon name="lucide:sparkles" class="size-4" />
                    Symfony 8 · Tailwind v4 · Alpine · Turbo
                </p>
                <h1 id="hero-title" class="mt-6 text-4xl font-black tracking-tight text-ink sm:text-6xl">
                    Un socle solide pour lancer
                    <span class="bg-gradient-to-r from-brand-700 to-accent-500 bg-clip-text text-transparent">votre prochain projet</span>
                </h1>
                <p class="mt-6 text-lg leading-8 text-muted">
                    Pages essentielles, back-office, emails transactionnels, SEO, accessibilité et données chiffrées :
                    tout est prêt, il ne reste qu'à construire.
                </p>
                <div class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row">
                    <twig:Button href="{{ path('app_contact') }}" size="lg" icon="lucide:arrow-right">Nous contacter</twig:Button>
                    <twig:Button href="#fonctionnalites" variant="secondary" size="lg">Découvrir</twig:Button>
                </div>
            </div>
        </div>
    </section>

    {# Fonctionnalités #}
    <twig:Section id="fonctionnalites" title="Tout l'essentiel, déjà branché" intro="Des briques éprouvées, configurées avec soin, pour démarrer vite sans dette technique." class="bg-gray-50">
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            <twig:Card title="Rapide par défaut" icon="lucide:zap">
                Turbo Drive pour une navigation instantanée, AssetMapper sans build Node, cache HTTP et OPcache en production.
            </twig:Card>
            <twig:Card title="Design system Tailwind v4" icon="lucide:palette">
                Thème centralisé en variables CSS, Twig Components réutilisables (boutons, alertes, cartes…).
            </twig:Card>
            <twig:Card title="Accessible" icon="lucide:accessibility">
                Lien d'évitement, focus visible, formulaires annotés, annonces des changements de page, respect des préférences de mouvement.
            </twig:Card>
            <twig:Card title="Données chiffrées" icon="lucide:database">
                Données personnelles chiffrées en base (XChaCha20-Poly1305), recherche par empreinte, purge RGPD automatisable.
            </twig:Card>
            <twig:Card title="Emails transactionnels" icon="lucide:mail-check">
                Brevo en production, Mailpit en local, templates responsive écrits en Twig.
            </twig:Card>
            <twig:Card title="Back-office" icon="lucide:layout-template">
                EasyAdmin 5 pour gérer utilisateurs et messages, export PDF inclus.
            </twig:Card>
        </div>
    </twig:Section>

    {# Appel à l'action #}
    <section class="py-16 sm:py-20" aria-labelledby="cta-title">
        <div class="container-page">
            <div class="rounded-3xl bg-brand-900 px-6 py-14 text-center shadow-xl sm:px-12">
                <h2 id="cta-title" class="text-2xl font-bold tracking-tight text-white sm:text-3xl">Un projet en tête ?</h2>
                <p class="mx-auto mt-3 max-w-xl text-brand-100">Parlons-en : nous vous répondons sous 48 heures ouvrées.</p>
                <div class="mt-8">
                    <twig:Button href="{{ path('app_contact') }}" variant="secondary" size="lg" icon="lucide:send">Écrire un message</twig:Button>
                </div>
            </div>
        </div>
    </section>
{% endblock %}
