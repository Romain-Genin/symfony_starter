{% extends 'account/_layout.html.twig' %}

{% block title %}{{ 'account.delete.title'|trans }}{% endblock %}
{% block heading %}{{ 'account.delete.title'|trans }}{% endblock %}
{% block breadcrumb %}1{% endblock %}

{% block account_content %}
    <twig:Alert type="warning" :title="'account.delete.warning_title'|trans" class="mb-6">
        {{ 'account.delete.warning'|trans }}
    </twig:Alert>
    {{ form_start(form, {attr: {novalidate: 'novalidate', class: 'space-y-5'}}) }}
        {{ form_row(form.password) }}
        <twig:Button variant="danger" icon="lucide:trash-2" iconPosition="start">{{ 'account.delete.submit'|trans }}</twig:Button>
    {{ form_end(form) }}
{% endblock %}
