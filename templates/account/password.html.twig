{% extends 'account/_layout.html.twig' %}

{% block title %}{{ 'form.password'|trans }}{% endblock %}
{% block heading %}{{ 'form.password'|trans }}{% endblock %}
{% block breadcrumb %}1{% endblock %}

{% block account_content %}
    {{ form_start(form, {attr: {novalidate: 'novalidate', class: 'space-y-5'}}) }}
        {{ form_row(form.currentPassword) }}
        {{ form_row(form.plainPassword) }}
        <twig:Button>{{ 'account.password.submit'|trans }}</twig:Button>
    {{ form_end(form) }}
{% endblock %}
