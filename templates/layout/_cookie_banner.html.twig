{#
    Bannière & préférences cookies (Alpine store « consent », assets/js/cookie-consent.js).
    data-turbo-permanent : conservée telle quelle entre les pages Turbo.
#}
{%- set consent_texts = {
    analytics: {label: 'cookies.analytics.label'|trans, description: 'cookies.analytics.description'|trans},
    marketing: {label: 'cookies.marketing.label'|trans, description: 'cookies.marketing.description'|trans},
} -%}
<div id="cookie-consent" data-turbo-permanent x-data="{ texts: {{ consent_texts|json_encode }} }">
    {# Bannière : non bloquante, « Refuser » au même niveau que « Accepter » #}
    <section x-show="$store.consent.bannerOpen && !$store.consent.preferencesOpen" x-cloak
             x-transition.opacity
             aria-labelledby="cookie-banner-title"
             class="fixed inset-x-0 bottom-0 z-50 p-4 sm:p-6">
        <div class="mx-auto max-w-3xl rounded-card bg-white p-5 shadow-2xl ring-1 ring-gray-200 sm:p-6">
            <div class="flex items-start gap-3">
                <twig:ux:icon name="lucide:cookie" class="mt-0.5 size-6 shrink-0 text-brand-700" />
                <div>
                    <h2 id="cookie-banner-title" class="font-semibold text-ink">{{ 'cookies.title'|trans }}</h2>
                    <p class="mt-1 text-sm text-muted">
                        {{ 'cookies.message'|trans }}
                        <a href="{{ path('app_legal_cookies') }}" class="link">{{ 'action.learn_more'|trans }}</a>
                    </p>
                </div>
            </div>
            <div class="mt-4 flex flex-col-reverse gap-2 sm:flex-row sm:justify-end">
                <twig:Button type="button" variant="ghost" x-on:click="$store.consent.openPreferences()">{{ 'cookies.customize'|trans }}</twig:Button>
                <twig:Button type="button" variant="secondary" x-on:click="$store.consent.rejectAll()">{{ 'cookies.reject'|trans }}</twig:Button>
                <twig:Button type="button" x-on:click="$store.consent.acceptAll()">{{ 'cookies.accept'|trans }}</twig:Button>
            </div>
        </div>
    </section>

    {# Dialogue de préférences : modal accessible (focus piégé, Échap pour fermer) #}
    <div x-show="$store.consent.preferencesOpen" x-cloak
         class="fixed inset-0 z-[60] flex items-end justify-center p-4 sm:items-center"
         @keydown.escape.window="$store.consent.preferencesOpen = false">
        <div class="absolute inset-0 bg-ink/50" x-show="$store.consent.preferencesOpen" x-transition.opacity @click="$store.consent.preferencesOpen = false" aria-hidden="true"></div>

        <div role="dialog" aria-modal="true" aria-labelledby="cookie-prefs-title"
             class="relative w-full max-w-lg rounded-card bg-white p-6 shadow-2xl"
             x-show="$store.consent.preferencesOpen" x-transition
             x-trap.noscroll.inert="$store.consent.preferencesOpen">
            <div class="flex items-start justify-between gap-4">
                <h2 id="cookie-prefs-title" class="text-lg font-semibold text-ink">{{ 'cookies.preferences'|trans }}</h2>
                <button type="button" class="-m-1 rounded p-1 text-muted hover:text-ink" @click="$store.consent.preferencesOpen = false">
                    <span class="sr-only">{{ 'action.close'|trans }}</span>
                    <twig:ux:icon name="lucide:x" class="size-5" />
                </button>
            </div>

            <ul class="mt-4 divide-y divide-gray-200">
                <li class="flex items-start justify-between gap-4 py-4">
                    <div>
                        <p class="font-medium text-ink" id="consent-necessary-label">{{ 'cookies.necessary.label'|trans }}</p>
                        <p class="text-sm text-muted">{{ 'cookies.necessary.description'|trans }}</p>
                    </div>
                    <span class="shrink-0 rounded-full bg-gray-100 px-2.5 py-1 text-xs font-medium text-muted">{{ 'cookies.always_on'|trans }}</span>
                </li>
                <template x-for="(category, key) in $store.consent.categories" :key="key">
                    <li class="flex items-start justify-between gap-4 py-4">
                        <div>
                            <p class="font-medium text-ink" :id="'consent-' + key + '-label'" x-text="texts[key]?.label ?? category.label"></p>
                            <p class="text-sm text-muted" :id="'consent-' + key + '-desc'" x-text="texts[key]?.description ?? category.description"></p>
                        </div>
                        <button type="button" role="switch"
                                :aria-checked="$store.consent.choices[key].toString()"
                                :aria-labelledby="'consent-' + key + '-label'"
                                :aria-describedby="'consent-' + key + '-desc'"
                                @click="$store.consent.choices[key] = !$store.consent.choices[key]"
                                :class="$store.consent.choices[key] ? 'bg-brand-700' : 'bg-gray-300'"
                                class="relative inline-flex h-6 w-11 shrink-0 cursor-pointer rounded-full transition-colors">
                            <span aria-hidden="true"
                                  :class="$store.consent.choices[key] ? 'translate-x-5' : 'translate-x-0.5'"
                                  class="mt-0.5 inline-block size-5 rounded-full bg-white shadow transition-transform"></span>
                        </button>
                    </li>
                </template>
            </ul>

            <div class="mt-6 flex flex-col-reverse gap-2 sm:flex-row sm:justify-end">
                <twig:Button type="button" variant="secondary" x-on:click="$store.consent.rejectAll()">{{ 'cookies.reject'|trans }}</twig:Button>
                <twig:Button type="button" variant="secondary" x-on:click="$store.consent.acceptAll()">{{ 'cookies.accept'|trans }}</twig:Button>
                <twig:Button type="button" x-on:click="$store.consent.save()">{{ 'cookies.save'|trans }}</twig:Button>
            </div>
        </div>
    </div>
</div>
