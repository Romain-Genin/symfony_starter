<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Connexion — Administration</title>
    {{ encore_entry_link_tags('app') }}
</head>
<body class="min-h-screen bg-slate-900 flex items-center justify-center p-4">

    <div class="w-full max-w-sm">

        {# Logo / titre #}
        <div class="text-center mb-8">
            <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-blue-600 mb-4">
                <i data-lucide="shield-check" class="w-7 h-7 text-white"></i>
            </div>
            <h1 class="text-2xl font-bold text-white">Administration</h1>
            <p class="text-slate-400 text-sm mt-1">Connecte-toi pour accéder au panneau</p>
        </div>

        {# Card #}
        <div class="bg-white rounded-2xl shadow-2xl p-8">

            {% if error %}
                <div class="mb-5 flex items-start gap-2 p-3 bg-red-50 border border-red-200 rounded-lg text-sm text-red-700">
                    <i data-lucide="alert-circle" class="w-4 h-4 mt-0.5 flex-shrink-0"></i>
                    <span>{{ error.messageKey|trans(error.messageData, 'security') }}</span>
                </div>
            {% endif %}

            <form method="post" novalidate>
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <div class="mb-4">
                    <label for="username" class="form-label">Adresse email</label>
                    <input
                        id="username"
                        type="email"
                        name="_username"
                        value="{{ last_username }}"
                        class="form-input"
                        autocomplete="email"
                        autofocus
                        required
                    >
                </div>

                <div class="mb-5">
                    <label for="password" class="form-label">Mot de passe</label>
                    <input
                        id="password"
                        type="password"
                        name="_password"
                        class="form-input"
                        autocomplete="current-password"
                        required
                    >
                </div>

                <label class="flex items-center gap-2 mb-6 text-sm text-gray-600 cursor-pointer select-none">
                    <input type="checkbox" name="_remember_me" class="rounded border-gray-300 text-blue-600">
                    Se souvenir de moi
                </label>

                <button type="submit" class="btn-primary w-full justify-center py-2.5">
                    Se connecter
                </button>
            </form>
        </div>

    </div>

    {{ encore_entry_script_tags('app') }}
</body>
</html>
