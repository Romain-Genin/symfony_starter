{% extends 'emails/layout.html.twig' %}

{% block content %}
    <h1>{{ 'email.reset_password.subject'|trans }}</h1>
    <p>{{ 'email.hello'|trans({'%name%': user.firstName ? ' ' ~ user.firstName : ''}) }}</p>
    <p>{{ 'email.reset_password.text'|trans }}</p>
    
    <p class="cta"><a href="{{ url('app_reset_password', {token: resetToken.token}) }}" class="button">{{ 'email.reset_password.button'|trans }}</a></p>
    
    <p class="muted">{{ 'email.reset_password.expires'|trans({'%delay%': resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle')}) }}</p>
{% endblock %}
