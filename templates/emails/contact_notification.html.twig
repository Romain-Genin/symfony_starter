{% extends 'emails/layout.html.twig' %}

{% block content %}
    <h1>{{ 'email.contact_notification.title'|trans }}</h1>
    <table class="meta">
        <tr><td class="label">{{ 'form.name'|trans }}</td><td>{{ message.name }}</td></tr>
        <tr><td class="label">{{ 'form.email'|trans }}</td><td><a href="mailto:{{ message.email }}">{{ message.email }}</a></td></tr>
        {% if message.phone %}<tr><td class="label">{{ 'form.phone'|trans }}</td><td>{{ message.phone }}</td></tr>{% endif %}
        <tr><td class="label">{{ 'form.subject'|trans }}</td><td>{{ message.subject }}</td></tr>
        <tr><td class="label">{{ 'email.contact_notification.received_at'|trans }}</td><td>{{ message.createdAt|format_datetime('long', 'short') }}</td></tr>
    </table>
    
    <div class="box">{{ message.message }}</div>
    
    <p>{{ 'email.contact_notification.reply'|trans({'%name%': message.name}) }}</p>
    <p><a href="{{ url('admin') }}">{{ 'email.contact_notification.admin_link'|trans }}</a></p>
{% endblock %}
