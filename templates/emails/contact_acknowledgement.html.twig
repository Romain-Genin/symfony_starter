{% extends 'emails/layout.html.twig' %}

{% block content %}
    <h1>{{ 'email.contact_acknowledgement.title'|trans({'%name%': message.name}) }}</h1>
    <p>{{ 'email.contact_acknowledgement.text'|trans({'%subject%': message.subject}) }}</p>
    <p class="muted">{{ 'email.contact_acknowledgement.summary'|trans }}</p>
    <div class="box">{{ message.message }}</div>
    
    <p>{{ 'email.signature'|trans({'%site%': site.name})|nl2br }}</p>
{% endblock %}
