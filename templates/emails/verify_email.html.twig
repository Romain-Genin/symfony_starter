{% extends 'emails/layout.html.twig' %}

{% block content %}
    <h1>Confirmez votre adresse email</h1>
    <p>Bonjour{{ user.firstName ? ' ' ~ user.firstName }},</p>
    <p>Merci pour votre inscription ! Pour activer votre compte, confirmez votre adresse email :</p>
    
    <p class="cta"><a href="{{ signedUrl }}" class="button">Confirmer mon adresse</a></p>
    
    <p class="muted">Ce lien expire le {{ expiresAt|date('d/m/Y à H:i') }}. Si vous n'êtes pas à l'origine de cette inscription, ignorez simplement cet email.</p>
{% endblock %}
