{% extends 'emails/layout.html.twig' %}

{% block content %}
    <h1>{{ 'email.verify_email.subject'|trans }}</h1>
    <p>{{ 'email.hello'|trans({'%name%': user.firstName ? ' ' ~ user.firstName : ''}) }}</p>
    <p>{{ 'email.verify_email.text'|trans }}</p>
    
    <p class="cta"><a href="{{ signedUrl }}" class="button">{{ 'email.verify_email.button'|trans }}</a></p>
    
    <p class="muted">{{ 'email.verify_email.expires'|trans({'%date%': expiresAt|format_datetime('long', 'short')}) }}</p>
{% endblock %}
