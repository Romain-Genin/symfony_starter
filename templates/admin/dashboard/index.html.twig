{% extends 'admin/base.html.twig' %}

{% block title %}Tableau de bord{% endblock %}

{% block content %}
<div class="p-8 pb-12">

    {# ── Section header ──────────────────────────────────────────── #}
    <div class="mb-6 flex items-start justify-between">
        <div>
            <h1 class="text-xl font-bold text-[var(--admin-fg)] mb-0.5">
                Bonjour, {{ app.user.name|split(' ')|first }} 👋
            </h1>
            <p class="text-[0.8125rem] text-[var(--admin-fg-muted)]">Voici un aperçu de votre espace d'administration</p>
        </div>
    </div>

    {# ── Stat cards ──────────────────────────────────────────────── #}
    <div class="mb-7 grid grid-cols-4 gap-3">

        {# Images #}
        <div class="admin-stat-card cursor-pointer" onclick="window.location='#'">
            <div class="mb-2.5 flex items-start justify-between">
                <span class="text-[0.6875rem] font-semibold uppercase tracking-[0.04em] text-[var(--admin-fg-muted)]">Images uploadées</span>
                <div class="flex h-[1.875rem] w-[1.875rem] flex-shrink-0 items-center justify-center rounded-lg bg-violet-100">
                    <i data-lucide="image" class="h-3.5 w-3.5 text-violet-400"></i>
                </div>
            </div>
            <div class="text-[1.625rem] font-extrabold leading-none text-[var(--admin-fg)]">{{ stats.images|default('—') }}</div>
        </div>

        {# Reviews #}
        <div class="admin-stat-card cursor-pointer" onclick="window.location='#'">
            <div class="mb-2.5 flex items-start justify-between">
                <span class="text-[0.6875rem] font-semibold uppercase tracking-[0.04em] text-[var(--admin-fg-muted)]">Avis clients</span>
                <div class="flex h-[1.875rem] w-[1.875rem] flex-shrink-0 items-center justify-center rounded-lg bg-rose-100">
                    <i data-lucide="star" class="h-3.5 w-3.5 text-rose-300"></i>
                </div>
            </div>
            <div class="text-[1.625rem] font-extrabold leading-none text-[var(--admin-fg)]">{{ stats.reviews|default('—') }}</div>
        </div>

        {# Last update #}
        <div class="admin-stat-card">
            <div class="mb-2.5 flex items-start justify-between">
                <span class="text-[0.6875rem] font-semibold uppercase tracking-[0.04em] text-[var(--admin-fg-muted)]">Dernière mise à jour</span>
                <div class="flex h-[1.875rem] w-[1.875rem] flex-shrink-0 items-center justify-center rounded-lg bg-green-100">
                    <i data-lucide="refresh-cw" class="h-3.5 w-3.5 text-green-400"></i>
                </div>
            </div>
            <div class="text-[1.625rem] font-extrabold leading-none text-[var(--admin-fg)]">{{ stats.lastUpdate|default('—') }}</div>
        </div>

        {# Site status #}
        <div class="admin-stat-card">
            <div class="mb-2.5 flex items-start justify-between">
                <span class="text-[0.6875rem] font-semibold uppercase tracking-[0.04em] text-[var(--admin-fg-muted)]">Site en ligne</span>
                <div class="flex h-[1.875rem] w-[1.875rem] flex-shrink-0 items-center justify-center rounded-lg bg-blue-100">
                    <i data-lucide="globe" class="h-3.5 w-3.5 text-blue-400"></i>
                </div>
            </div>
            <div class="text-[1.625rem] font-extrabold leading-none text-[var(--admin-fg)]">{{ stats.siteStatus|default('—') }}</div>
        </div>

    </div>

    {# ── Quick access + Site status ──────────────────────────────── #}
    <div class="grid grid-cols-2 gap-4">

        {# Quick access #}
        <div class="admin-card overflow-hidden">
            <div class="admin-sidebar-border-b px-[1.125rem] py-3.5 text-[0.8125rem] font-bold text-[var(--admin-fg)]">
                Accès rapides
            </div>
            <div class="flex flex-col gap-0.5 p-2.5">

                {% set shortcuts = [
                    { icon: 'image',      label: 'Gérer les images',           href: '#' },
                    { icon: 'building-2', label: 'Modifier mes informations',   href: '#' },
                    { icon: 'clock',      label: 'Mettre à jour les horaires',  href: '#' },
                    { icon: 'star',       label: 'Voir les avis clients',       href: '#' },
                    { icon: 'share-2',    label: 'Réseaux sociaux',             href: '#' },
                ] %}

                {% for s in shortcuts %}
                <a href="{{ s.href }}" class="admin-shortcut-link">
                    <div class="flex h-7 w-7 flex-shrink-0 items-center justify-center rounded-lg bg-[var(--admin-muted)]">
                        <i data-lucide="{{ s.icon }}" class="h-[0.8125rem] w-[0.8125rem] text-[var(--admin-fg-muted)]"></i>
                    </div>
                    {{ s.label }}
                    <i data-lucide="chevron-right" class="ml-auto h-[0.8125rem] w-[0.8125rem] flex-shrink-0 text-[var(--admin-fg-muted)]"></i>
                </a>
                {% endfor %}

            </div>
        </div>

        {# Site status #}
        <div class="admin-card p-5">
            <div class="mb-4 text-[0.8125rem] font-bold text-[var(--admin-fg)]">État du site</div>

            <div class="flex items-center justify-between border-b border-black/[0.06] py-2">
                <span class="text-xs text-[var(--admin-fg-muted)]">Statut</span>
                <span class="badge badge-success">En ligne</span>
            </div>
            <div class="flex items-center justify-between border-b border-black/[0.06] py-2">
                <span class="text-xs text-[var(--admin-fg-muted)]">Domaine</span>
                <span class="font-mono text-xs text-[var(--admin-fg-muted)]">monsiteweb.fr</span>
            </div>
            <div class="flex items-center justify-between border-b border-black/[0.06] py-2">
                <span class="text-xs text-[var(--admin-fg-muted)]">Dernière modif.</span>
                <span class="text-xs text-[var(--admin-fg-muted)]">{{ stats.lastUpdate|default('—') }}</span>
            </div>
            <div class="flex items-center justify-between border-b border-black/[0.06] py-2">
                <span class="text-xs text-[var(--admin-fg-muted)]">Images</span>
                <span class="text-xs font-semibold text-[var(--admin-fg)]">{{ stats.images is defined ? stats.images ~ ' fichiers' : '—' }}</span>
            </div>
            <div class="flex items-center justify-between py-2">
                <span class="text-xs text-[var(--admin-fg-muted)]">Avis clients</span>
                <span class="text-xs font-semibold text-[var(--admin-fg)]">{{ stats.reviews is defined ? stats.reviews ~ ' avis' : '—' }}</span>
            </div>

            <div class="mt-4">
                <a href="#" class="admin-see-site-btn">
                    <i data-lucide="external-link" class="h-[0.8125rem] w-[0.8125rem]"></i>
                    Voir mon site
                </a>
            </div>
        </div>

    </div>
</div>
{% endblock %}
