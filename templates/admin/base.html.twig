<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Dashboard{% endblock %} — Administration</title>
    {% block stylesheets %}{{ encore_entry_link_tags('app') }}{% endblock %}
    {% block head %}{% endblock %}
</head>
<body class="admin-body">

<div class="flex min-h-screen">

    {# ── Sidebar ───────────────────────────────────────────────── #}
    <aside class="admin-sidebar">

        {# Logo area #}
        <div class="admin-sidebar-border-b flex flex-shrink-0 items-center gap-[1rem] px-[1.8rem] pt-[2rem] pb-[1.4rem]">
            <img src="/studioastra/logo.svg" class="h-[2.8rem]" alt="Logo">
            <div>
                <div class="text-[1.3rem] font-bold leading-tight text-[var(--admin-fg)]">{% block site_title %}Mon Site Web{% endblock %}</div>
                <div class="text-[1.1rem] text-[var(--admin-fg-muted)]">Administration</div>
            </div>
        </div>

        {# Navigation #}
        <nav class="flex flex-1 flex-col gap-[0.1rem] overflow-y-auto px-[0.8rem] py-[1rem]">
            {% block sidebar_nav %}{% include 'admin/_nav.html.twig' %}{% endblock %}
        </nav>

        {# User footer #}
        <div class="admin-sidebar-border-t flex-shrink-0 p-[1.2rem]">
            <div class="mb-[0.6rem] flex items-center gap-[0.9rem] px-[1rem] py-[0.8rem]">
                {% set nameParts = app.user.name|split(' ') %}
                {% set initials = (nameParts[0]|first ~ (nameParts[1] is defined ? nameParts[1]|first : ''))|upper %}
                <div class="admin-avatar">{{ initials }}</div>
                <div class="min-w-0 flex-1">
                    <div class="truncate text-[1.2rem] font-semibold text-[var(--admin-fg)]">{{ app.user.name }}</div>
                    <div class="text-[1.1rem] text-[var(--admin-fg-muted)]">Administrateur</div>
                </div>
            </div>
            <a href="{{ path('admin_logout') }}" class="admin-logout-btn">
                <i data-lucide="log-out" class="h-[1.3rem] w-[1.3rem] flex-shrink-0"></i>
                Déconnexion
            </a>
        </div>
    </aside>

    {# ── Main content ──────────────────────────────────────────── #}
    <main class="ml-[22rem] flex-1 min-h-screen overflow-y-auto">

        {# Flash messages #}
        {% for type, messages in app.flashes %}
            {% for message in messages %}
                <div class="flash flash-{{ type == 'error' ? 'error' : type }}">
                    <i data-lucide="{{ type == 'success' ? 'check-circle' : (type == 'error' ? 'alert-circle' : (type == 'warning' ? 'alert-triangle' : 'info')) }}"
                       class="mt-[0.1rem] h-[1.5rem] w-[1.5rem] flex-shrink-0"></i>
                    <span>{{ message }}</span>
                </div>
            {% endfor %}
        {% endfor %}

        {% block content %}{% endblock %}
    </main>
</div>

{% block javascripts %}{{ encore_entry_script_tags('app') }}{% endblock %}

<script>
(function () {
    var details = document.getElementById('nav-modules');
    if (!details) return;
    var saved = localStorage.getItem('ga_modules_open');
    if (saved === 'false') details.removeAttribute('open');
    details.addEventListener('toggle', function () {
        localStorage.setItem('ga_modules_open', details.open);
    });
}());
</script>
</body>
</html>
