{% set route = app.request.attributes.get('_route') %}

{% macro item(current_route, route_name, label, icon, prefix) %}
    {% set active = current_route starts with (prefix ?? route_name) %}
    <li>
        <a href="{{ path(route_name) }}"
           class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium transition-colors duration-100
                  {{ active ? 'bg-white/10 text-white' : 'text-slate-400 hover:bg-white/5 hover:text-slate-200' }}">
            <i data-lucide="{{ icon }}" class="w-4 h-4 flex-shrink-0"></i>
            <span>{{ label }}</span>
        </a>
    </li>
{% endmacro %}

<ul class="space-y-0.5 px-3">
    {{ _self.item(route, 'admin_dashboard', 'Dashboard', 'layout-dashboard', 'admin_dashboard') }}
</ul>

