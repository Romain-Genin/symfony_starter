{% extends 'layout/auth.html.twig' %}

{% block title %}{{ 'auth.register'|trans }}{% endblock %}
{% block heading %}{{ 'auth.register'|trans }}{% endblock %}
{% block subheading %}{{ 'registration.subheading'|trans }}{% endblock %}

{% block card %}
    {{ form_start(form, {attr: {novalidate: 'novalidate', class: 'space-y-5'}}) }}
        {{ form_errors(form) }}
        <div class="grid gap-5 sm:grid-cols-2">
            {{ form_row(form.firstName) }}
            {{ form_row(form.lastName) }}
        </div>
        {{ form_row(form.email) }}
        {{ form_row(form.plainPassword) }}
        {{ form_row(form.agreeTerms, {label_html: false}) }}
        {{ form_row(form.antispam) }}
        {{ form_rest(form) }}
        <p class="text-xs text-muted">
            {{ 'registration.privacy'|trans({'%link%': '<a href="' ~ path('app_legal_privacy') ~ '" class="link">' ~ 'contact.privacy_link'|trans ~ '</a>'})|raw }}
        </p>
        <twig:Button class="w-full" icon="lucide:user-plus" iconPosition="start">{{ 'registration.submit'|trans }}</twig:Button>
    {{ form_end(form) }}
{% endblock %}

{% block after_card %}
    <p class="mt-6 text-center text-sm text-muted">
        {{ 'registration.already'|trans }} <a href="{{ path('app_login') }}" class="link">{{ 'login.submit'|trans }}</a>
    </p>
{% endblock %}
