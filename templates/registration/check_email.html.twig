{% extends 'layout/auth.html.twig' %}

{% block title %}{{ 'registration.check_email.title'|trans }}{% endblock %}
{% block heading %}{{ 'registration.check_email.title'|trans }}{% endblock %}

{% block card %}
    <div class="space-y-4 text-sm text-muted">
        <div class="flex justify-center"><twig:ux:icon name="lucide:mail-check" class="size-12 text-brand-700" /></div>
        <p>{{ 'registration.check_email.text'|trans }}</p>
        <p>{{ 'registration.check_email.validity'|trans }}</p>
    </div>
{% endblock %}

{% block after_card %}
    <p class="mt-6 text-center text-sm text-muted">
        {{ 'registration.check_email.nothing'|trans }} <a href="{{ path('app_register_resend') }}" class="link">{{ 'registration.resend.submit'|trans }}</a>
    </p>
{% endblock %}
