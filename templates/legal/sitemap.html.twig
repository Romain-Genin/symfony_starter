{% extends 'legal/_layout.html.twig' %}

{% block title %}{{ 'footer.sitemap'|trans }}{% endblock %}
{% block meta_description %}{{ 'legal.sitemap.meta_description'|trans({'%site%': site.name}) }}{% endblock %}
{% block updated_at %}04/11/2026{% endblock %}

{% block legal_content %}
    <ul>
        <li><a href="{{ path('app_home') }}">{{ 'nav.home'|trans }}</a></li>
        <li><a href="{{ path('app_contact') }}">{{ 'nav.contact'|trans }}</a></li>
        {% if app_module('shop') %}<li><a href="{{ path('astra_catalog') }}">{{ 'nav.shop'|trans }}</a></li>{% endif %}
        <li>{{ 'legal.sitemap.my_space'|trans }}
            <ul>
                <li><a href="{{ path('app_login') }}">{{ 'auth.login'|trans }}</a></li>
                <li><a href="{{ path('app_register') }}">{{ 'auth.register'|trans }}</a></li>
                <li><a href="{{ path('app_forgot_password_request') }}">{{ 'reset_password.request.title'|trans }}</a></li>
            </ul>
        </li>
        <li>{{ 'footer.legal'|trans }}
            <ul>
                <li><a href="{{ path('app_legal_notice') }}">{{ 'footer.legal_notice'|trans }}</a></li>
                <li><a href="{{ path('app_legal_privacy') }}">{{ 'footer.privacy_policy'|trans }}</a></li>
                <li><a href="{{ path('app_legal_cookies') }}">{{ 'footer.cookie_policy'|trans }}</a></li>
                <li><a href="{{ path('app_legal_terms') }}">{{ 'legal.sitemap.terms'|trans }}</a></li>
                <li><a href="{{ path('app_legal_accessibility') }}">{{ 'legal.sitemap.accessibility'|trans }}</a></li>
            </ul>
        </li>
    </ul>
{% endblock %}
