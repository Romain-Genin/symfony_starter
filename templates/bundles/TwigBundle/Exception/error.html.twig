{#
    Pages d'erreur (prod). Prévisualisation en dev : /_error/404, /_error/403, /_error/500…
    Le texte s'adapte au code HTTP ; un template errorXXX.html.twig peut surcharger un code précis.
#}
{% extends 'base.html.twig' %}

{#- Textes : error.<code>_title / error.<code>_text dans translations/messages.<langue>.yaml -#}
{%- set known = [400, 403, 404, 405, 410, 419, 429, 500, 503] -%}
{%- set message = status_code in known
    ? {title: ('error.' ~ status_code ~ '_title')|trans, text: ('error.' ~ status_code ~ '_text')|trans}
    : {title: 'error.default_title'|trans, text: 'error.default_text'|trans} -%}

{% block title %}{{ message.title }}{% endblock %}
{% block robots %}noindex, nofollow{% endblock %}
{% block canonical %}{{ url('app_home') }}{% endblock %}

{% block body %}
    <section class="container-page flex flex-col items-center py-20 text-center sm:py-28" aria-labelledby="error-title">
        <p class="text-sm font-semibold uppercase tracking-widest text-brand-700">{{ 'error.code'|trans({'%code%': status_code}) }}</p>
        <h1 id="error-title" class="mt-3 text-4xl font-black tracking-tight text-ink sm:text-5xl">{{ message.title }}</h1>
        <p class="mt-4 max-w-lg text-lg text-muted">{{ message.text }}</p>
        <div class="mt-10 flex flex-col gap-3 sm:flex-row">
            <twig:Button href="{{ path('app_home') }}" icon="lucide:house" iconPosition="start">{{ 'error.back_home'|trans }}</twig:Button>
            <twig:Button href="{{ path('app_contact') }}" variant="secondary">{{ 'error.report'|trans }}</twig:Button>
        </div>
    </section>
{% endblock %}
