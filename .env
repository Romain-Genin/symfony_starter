# ============================================================
# ENVIRONNEMENT APPLICATION
# Copie ce fichier en .env.local pour les surcharges locales
# Ne jamais committer .env.local
# ============================================================

APP_ENV=dev
APP_SECRET=changeme_generate_with_openssl_rand_hex_32

# ============================================================
# BASE DE DONNÉES (MariaDB 10.11)
# ============================================================
DB_HOST=mariadb
DB_PORT=3306
DB_NAME=symfony
DB_USER=symfony
DB_PASSWORD=symfony
DB_ROOT_PASSWORD=root

DATABASE_URL="mysql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?serverVersion=10.11.0-MariaDB&charset=utf8mb4"

# ============================================================
# MAILER
# Dev  → Mailpit (catch-all local, UI sur http://localhost:8025)
# Prod → Scaleway TEM (SMTP)
# ============================================================
MAILER_DSN=smtp://mailpit:1025
MAILER_SENDER_EMAIL=noreply@monprojet.fr
MAILER_SENDER_NAME="Mon Projet"

# --- Scaleway TEM (décommenter en production / .env.local) ---
# MAILER_DSN=smtp://your_project_id:your_api_secret_key@smtp.tem.scw.cloud:587
# Documentation : https://www.scaleway.com/en/docs/managed-services/transactional-email/

# ============================================================
# SCALEWAY (autres services si besoin)
# ============================================================
# SCW_ACCESS_KEY=
# SCW_SECRET_KEY=
# SCW_DEFAULT_ORGANIZATION_ID=
# SCW_DEFAULT_PROJECT_ID=
# SCW_DEFAULT_REGION=fr-par
# SCW_DEFAULT_ZONE=fr-par-1

# ============================================================
# DOCKER PORTS (override dans .env.local si ports déjà utilisés)
# ============================================================
NGINX_PORT=8080
DB_EXTERNAL_PORT=3306
MAILPIT_UI_PORT=8025
