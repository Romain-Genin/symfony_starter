# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# En prod (Coolify), toutes les valeurs sensibles sont des variables d'environnement.

# Nom du projet Docker (conteneurs, volumes) — défini par bin/init-project.php
COMPOSE_PROJECT_NAME=sa_symfony

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# URL publique du site (utilisée dans les emails, le sitemap, les URLs canoniques en CLI)
DEFAULT_URI=http://localhost:8080
###< symfony/routing ###

# Indexation moteurs de recherche : 1 UNIQUEMENT sur le domaine de production
APP_INDEXABLE=0

# Proxies de confiance (Coolify / Traefik)
TRUSTED_PROXIES=private_ranges

###> doctrine/doctrine-bundle ###
DATABASE_URL="postgresql://app:app@database:5432/app?serverVersion=17&charset=utf8"
###< doctrine/doctrine-bundle ###

###> app/encryption ###
# Clé de chiffrement des données personnelles en base (XChaCha20-Poly1305).
# Générer : make encryption-key   (ou php bin/console app:encryption:generate-key)
# ⚠️ Perdre cette clé = perdre définitivement les données chiffrées.
APP_ENCRYPTION_KEY=
###< app/encryption ###

###> symfony/mailer ###
# Local : Mailpit (http://localhost:8025)
MAILER_DSN=smtp://mailpit:1025
MAILER_FROM="Mon site <no-reply@example.com>"
# Destinataire des messages du formulaire de contact
CONTACT_RECIPIENT=contact@example.com
###< symfony/mailer ###

###> symfony/brevo-mailer ###
# Prod : transport API Brevo (recommandé)
# MAILER_DSN=brevo+api://API_KEY@default
###< symfony/brevo-mailer ###
