# ============================================================
# Copie ce fichier en .env.local pour les surcharges locales
# Ne jamais committer .env.local
# ============================================================

APP_ENV=dev
APP_SECRET=changeme_generate_with_openssl_rand_hex_32

# ── Base de données ──────────────────────────────────────────
DB_HOST=mariadb
DB_PORT=3306
DB_NAME=symfony
DB_USER=symfony
DB_PASSWORD=symfony
DB_ROOT_PASSWORD=root

DATABASE_URL="mysql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?serverVersion=10.11.0-MariaDB&charset=utf8mb4"

# ── Mailer ───────────────────────────────────────────────────
# Dev  → Mailpit (UI : http://localhost:8025)
# Prod → décommenter Scaleway TEM ci-dessous dans .env.local
MAILER_DSN=smtp://mailpit:1025
MAILER_SENDER_EMAIL=noreply@monprojet.fr
MAILER_SENDER_NAME="Mon Projet"

# MAILER_DSN=smtp://<project_id>:<api_key>@smtp.tem.scw.cloud:587

# ── Push Notifications (VAPID) ───────────────────────────────
# Générer avec : make vapid-keys
VAPID_PUBLIC_KEY=changeme_run_make_vapid_keys
VAPID_PRIVATE_KEY=changeme_run_make_vapid_keys
VAPID_SUBJECT=mailto:contact@monprojet.fr

# ── Ports Docker ────────────────────────────────────────────
NGINX_PORT=8080
DB_PORT=3306
MAILPIT_UI_PORT=8025
